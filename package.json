{
  "name": "screen-curtain",
  "version": "1.0.19",
  "type": "commonjs",
  "packageManager": "bun@1.4.4",
  "description": "Chrome extension to shade/cover page content with a resizable overlay",
  "homepage": "https://github.com/1llum1n4t1s/ScreenGuard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1llum1n4t1s/ScreenGuard.git"
  },
  "scripts": {
    "deps": "bun scripts/Install-Dependencies.mjs",
    "sync:support": "bun --preserve-symlinks-main ./node_modules/@kagayoi/support-extension/bin/kagayoi-support-sync.mjs",
    "generate-icons": "bun scripts/generate-icons.js",
    "generate-screenshots": "bun webstore/generate-screenshots.js",
    "build": "bun --bun run sync:support && bun --bun run generate-icons && bun --bun run generate-screenshots"
  },
  "devDependencies": {
    "@kagayoi/support-extension": "1.0.9",
    "puppeteer": "^25.16.0",
    "sharp": "^0.35.5"
  },
  "keywords": [
    "chrome-extension",
    "screen-shade",
    "overlay",
    "privacy"
  ],
  "author": "ゆろち <yuro.7878@gmail.com>",
  "license": "MIT",
  "trustedDependencies": [
    "sharp",
    "puppeteer"
  ]
}
